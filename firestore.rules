rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validNullableString(field, maxLength) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLength);
    }

    function validWatchlistMovie() {
      return hasOnlyFields(['tmdbId', 'title', 'releaseYear', 'posterPath', 'savedAt'])
        && request.resource.data.tmdbId is number
        && request.resource.data.tmdbId > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 220
        && validNullableString('releaseYear', 12)
        && validNullableString('posterPath', 180)
        && request.resource.data.savedAt is timestamp;
    }

    function validViewingFieldKeys() {
      return request.resource.data.keys().hasOnly([
        'tmdbId',
        'mediaType',
        'watchedAt',
        'location',
        'rating',
        'rewatch',
        'review',
        'tags',
        'source',
        'sourceUri',
        'sourceKey',
        'importTitle',
        'importYear',
        'createdAt',
        'updatedAt'
      ]) || request.resource.data.keys().hasOnly([
        'tmdbId',
        'watchedAt',
        'location',
        'rating',
        'rewatch',
        'review',
        'tags',
        'source',
        'sourceUri',
        'sourceKey',
        'importTitle',
        'importYear',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validViewing() {
      return validViewingFieldKeys()
      && request.resource.data.tmdbId is number
      && request.resource.data.watchedAt is timestamp
      && request.resource.data.location in ['cinema', 'home', 'other', 'unknown']
      && (request.resource.data.rating == null || (request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 5))
      && request.resource.data.rewatch is bool
      && validNullableString('review', 5000)
      && request.resource.data.tags is list
      && request.resource.data.tags.size() <= 50
      && request.resource.data.source in ['letterboxd', 'rewind']
      && validNullableString('sourceUri', 500)
      && request.resource.data.sourceKey is string
      && request.resource.data.sourceKey.size() > 0
      && validNullableString('importTitle', 220)
      && (request.resource.data.importYear == null || request.resource.data.importYear is number)
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    // users/{uid}/watchlist/{tmdbId}
    // users/{uid}/viewings/{viewingId}
    match /users/{userId}/watchlist/{tmdbId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validWatchlistMovie();
    }

    match /users/{userId}/viewings/{viewingId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && validViewing()
        && request.resource.data.keys().hasOnly([
          'tmdbId',
          'mediaType',
          'watchedAt',
          'location',
          'rating',
          'rewatch',
          'review',
          'tags',
          'source',
          'sourceUri',
          'sourceKey',
          'importTitle',
          'importYear',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.mediaType in ['movie', 'tv'];
      allow update: if isOwner(userId) && validViewing() && (
        !('mediaType' in request.resource.data)
        || request.resource.data.mediaType in ['movie', 'tv']
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
