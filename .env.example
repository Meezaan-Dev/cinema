# Server-side TMDB credentials — never prefix with VITE_
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Client-side TMDB image CDN (not a secret)
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Client-side Firebase Web config (not a secret)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rewind-video-club.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rewind-video-club
VITE_FIREBASE_STORAGE_BUCKET=rewind-video-club.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=414216833089
VITE_FIREBASE_APP_ID=1:414216833089:web:5839a29d3dc6d12ace5ec0

# Server-side Firebase Admin configuration
FIREBASE_PROJECT_ID=rewind-video-club
FIRESTORE_DATABASE_ID=rewind-db
REWIND_OWNER_ID=personal

# Local development uses your existing `firebase login` credentials by default.
# Optional CI/service-account fallback. Do not commit JSON credential values.
FIREBASE_SERVICE_ACCOUNT_JSON=
